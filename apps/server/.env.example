# Copy to .env (in apps/server) and fill in.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/chauffr.db

# OAuth client ID (type "Web application") from Google Cloud Console → APIs & Services → Credentials.
# Add http://localhost:5173, :5174 and :5175 (and your production domains) as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Comma-separated Google emails allowed into the admin dashboard.
ADMIN_EMAILS=

# Local development only: shows an email-only sign-in form so you can test without Google. Ignored in production.
DEV_LOGIN=1
