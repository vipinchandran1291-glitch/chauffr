PORT=3000
DATABASE_PATH=data/chauffr.db

# OAuth client ID (type "Web application") from Google Cloud Console.
# Add each app's origin (e.g. http://localhost:5173) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Comma-separated Google emails allowed into the admin dashboard.
ADMIN_EMAILS=

# Local development only: sign in with any email, no Google needed.
DEV_LOGIN=true

# Razorpay (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys until go-live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same secret as the webhook at Account & Settings > Webhooks, pointing to
# https://<your-domain>/api/payments/razorpay/webhook (payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=
